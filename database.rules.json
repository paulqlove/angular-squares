{
  "rules": {
    "games": {
      "$gameId": {
        ".read": true,
        ".write": "auth != null && (data.child('ownerId').val() == auth.uid || data.child('managerId').val() == auth.uid || (!data.exists() && (!root.child('users').child(auth.uid).child('activeBoardId').exists() || !root.child('games').child(root.child('users').child(auth.uid).child('activeBoardId').val()).exists() || (root.child('games').child(root.child('users').child(auth.uid).child('activeBoardId').val()).child('espnEventId').val() == null && root.child('games').child(root.child('users').child(auth.uid).child('activeBoardId').val()).child('createdAt').isNumber() && now >= root.child('games').child(root.child('users').child(auth.uid).child('activeBoardId').val()).child('createdAt').val() + 172800000))))",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "venmoUsername": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "homeTeam": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "awayTeam": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "pricePerSquare": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
        },
        "squares": {
          ".write": "auth != null",
          "$key": {
            ".validate": "$key.matches(/^[0-9]-[0-9]$/) && newData.isString() && newData.val().length <= 50"
          }
        },
        "selectedSquares": {
          "$key": {
            ".validate": "$key.matches(/^[0-9]-[0-9]$/) && newData.isString() && newData.val().length <= 50"
          }
        },
        "scores": {
          "$quarter": {
            "home": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            },
            "away": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            }
          }
        },
        "homeNumbers": {
          "$index": {
            ".validate": "(newData.val() == null) || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 9)"
          }
        },
        "awayNumbers": {
          "$index": {
            ".validate": "(newData.val() == null) || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 9)"
          }
        },
        "playerColors": {
          ".write": "auth != null",
          "$player": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          }
        },
        "playerUserIds": {
          ".write": "auth != null",
          "$player": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "winners": {
          "$quarter": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          }
        },
        "paidPlayers": {
          ".write": "auth != null",
          "$index": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          }
        },
        "ownerId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "ownerName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "managerId": {
          ".validate": "(newData.val() == null) || (newData.isString() && newData.val().length <= 128)"
        },
        "managerEmail": {
          ".validate": "(newData.val() == null) || (newData.isString() && newData.val().length <= 254)"
        },
        "isLocked": {
          ".validate": "newData.isBoolean()"
        },
        "isRandomized": {
          ".validate": "newData.isBoolean()"
        },
        "espnEventId": {
          ".validate": "(newData.val() == null) || (newData.isString() && newData.val().length <= 50)"
        },
        "espnSport": {
          ".validate": "(newData.val() == null) || (newData.isString() && newData.val().length <= 20)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId",
        "games": {
          "$gameId": {
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            }
          }
        },
        "joinedGames": {
          "$gameId": {
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            }
          }
        },
        "activeBoardId": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9]+$/)"
        }
      }
    },
    "notifyMe": {
      ".read": false,
      "$pushId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && $pushId.length <= 128 && $pushId.matches(/^[A-Za-z0-9_-]+$/)",
        ".validate": "newData.hasChildren(['email', 'timestamp', 'uid', 'source'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 254 && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)"
        },
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000 && newData.val() >= now - 86400000"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() == auth.uid && newData.val().length <= 128"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "emailIndex": {
      "$email": {
        ".read": "auth != null",
        ".write": "auth != null && newData.val() == auth.uid"
      }
    }
  }
}
