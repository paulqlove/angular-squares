{
  "rules": {
    "games": {
      "$gameId": {
        ".read": true,
        ".write": "auth != null && (data.child('ownerId').val() == auth.uid || data.child('managerId').val() == auth.uid || (!data.exists() && (root.child('admins').child(auth.uid).val() == true || (root.child('entitlements').child(auth.uid).child('expiresAt').isNumber() && root.child('entitlements').child(auth.uid).child('expiresAt').val() > now) || (auth.token.email_verified == true && root.child('giftedSeasonPass').child(auth.token.email.toLowerCase().replace('.', ',')).child('expiresAt').isNumber() && root.child('giftedSeasonPass').child(auth.token.email.toLowerCase().replace('.', ',')).child('expiresAt').val() > now) || !root.child('users').child(auth.uid).child('activeBoardId').exists() || !root.child('games').child(root.child('users').child(auth.uid).child('activeBoardId').val()).exists() || (root.child('games').child(root.child('users').child(auth.uid).child('activeBoardId').val()).child('espnEventId').val() == null && root.child('games').child(root.child('users').child(auth.uid).child('activeBoardId').val()).child('createdAt').isNumber() && now >= root.child('games').child(root.child('users').child(auth.uid).child('activeBoardId').val()).child('createdAt').val() + 172800000))))",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "venmoUsername": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "hostNote": {
          ".validate": "newData.isString() && newData.val().length <= 140"
        },
        "homeTeam": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "awayTeam": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "pricePerSquare": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
        },
        "squares": {
          "$key": {
            ".write": "auth != null && (!data.exists() || root.child('games').child($gameId).child('playerUserIds').child(data.val()).val() == auth.uid) && (!newData.exists() || newData.parent().parent().child('playerUserIds').child(newData.val()).val() == auth.uid) && ((data.exists() && newData.exists()) || root.child('games').child($gameId).child('isLocked').val() != true)",
            ".validate": "$key.matches(/^[0-9]-[0-9]$/) && newData.isString() && newData.val().length <= 50"
          }
        },
        "selectedSquares": {
          "$key": {
            ".validate": "$key.matches(/^[0-9]-[0-9]$/) && newData.isString() && newData.val().length <= 50"
          }
        },
        "scores": {
          "$quarter": {
            "home": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            },
            "away": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            }
          }
        },
        "homeNumbers": {
          "$index": {
            ".validate": "(newData.val() == null) || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 9)"
          }
        },
        "awayNumbers": {
          "$index": {
            ".validate": "(newData.val() == null) || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 9)"
          }
        },
        "playerColors": {
          "$player": {
            ".write": "auth != null && (!data.exists() || root.child('games').child($gameId).child('playerUserIds').child($player).val() == auth.uid)",
            ".validate": "newData.isString() && newData.val().length <= 50"
          }
        },
        "playerUserIds": {
          "$player": {
            ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid) || (data.val() == auth.uid && !newData.exists()))",
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "winners": {
          "$quarter": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          }
        },
        "paidPlayers": {
          "$index": {
            ".write": "auth != null && data.exists() && newData.exists() && root.child('games').child($gameId).child('playerUserIds').child(data.val()).val() == auth.uid && newData.parent().parent().child('playerUserIds').child(newData.val()).val() == auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 50"
          }
        },
        "ownerId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "ownerName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "managerId": {
          ".validate": "(newData.val() == null) || (newData.isString() && newData.val().length <= 128)"
        },
        "managerEmail": {
          ".validate": "(newData.val() == null) || (newData.isString() && newData.val().length <= 254)"
        },
        "isLocked": {
          ".validate": "newData.isBoolean()"
        },
        "isRandomized": {
          ".validate": "newData.isBoolean()"
        },
        "espnEventId": {
          ".validate": "(newData.val() == null) || (newData.isString() && newData.val().length <= 50)"
        },
        "espnSport": {
          ".validate": "(newData.val() == null) || (newData.isString() && newData.val().length <= 20)"
        },
        "espnLive": {
          ".validate": "newData.hasChildren(['status', 'period', 'clock', 'completed', 'homeScore', 'awayScore', 'homeTeam', 'awayTeam', 'quarters']) && newData.child('status').isString() && newData.child('status').val().length <= 10 && newData.child('period').isNumber() && newData.child('clock').isString() && newData.child('clock').val().length <= 20 && newData.child('completed').isBoolean() && newData.child('homeScore').isNumber() && newData.child('awayScore').isNumber() && newData.child('homeTeam').isString() && newData.child('homeTeam').val().length <= 50 && newData.child('awayTeam').isString() && newData.child('awayTeam').val().length <= 50",
          "quarters": {
            "$index": {
              ".validate": "$index.matches(/^[0-9]$/)",
              "home": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              },
              "away": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
              }
            }
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "adFreeUntil": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() == 0 || root.child('admins').child(auth.uid).val() == true || (root.child('entitlements').child(auth.uid).child('expiresAt').isNumber() && newData.val() <= root.child('entitlements').child(auth.uid).child('expiresAt').val()) || (auth.token.email_verified == true && root.child('giftedSeasonPass').child(auth.token.email.toLowerCase().replace('.', ',')).child('expiresAt').isNumber() && newData.val() <= root.child('giftedSeasonPass').child(auth.token.email.toLowerCase().replace('.', ',')).child('expiresAt').val()))"
        },
        "autoManage": {
          ".validate": "newData.hasChildren(['enabled']) && newData.child('enabled').val() == true && (!newData.child('resize').exists() || newData.child('resize').isBoolean()) && (root.child('admins').child(auth.uid).val() == true || (root.child('entitlements').child(auth.uid).child('expiresAt').isNumber() && root.child('entitlements').child(auth.uid).child('expiresAt').val() > now) || (auth.token.email_verified == true && root.child('giftedSeasonPass').child(auth.token.email.toLowerCase().replace('.', ',')).child('expiresAt').isNumber() && root.child('giftedSeasonPass').child(auth.token.email.toLowerCase().replace('.', ',')).child('expiresAt').val() > now))",
          "enabled": { ".validate": "newData.isBoolean()" },
          "resize": { ".validate": "newData.isBoolean()" },
          "runAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        },
        "emptyQuarterRule": {
          ".validate": "newData.isString() && (newData.val() == 'final' || newData.val() == 'redistribute')"
        },
        "quarterSplit": {
          ".validate": "newData.hasChildren(['q1', 'q2', 'q3', 'q4']) && newData.child('q1').val() + newData.child('q2').val() + newData.child('q3').val() + newData.child('q4').val() == 1000 && (root.child('admins').child(auth.uid).val() == true || (root.child('entitlements').child(auth.uid).child('expiresAt').isNumber() && root.child('entitlements').child(auth.uid).child('expiresAt').val() > now) || (auth.token.email_verified == true && root.child('giftedSeasonPass').child(auth.token.email.toLowerCase().replace('.', ',')).child('expiresAt').isNumber() && root.child('giftedSeasonPass').child(auth.token.email.toLowerCase().replace('.', ',')).child('expiresAt').val() > now))",
          "q1": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 == 0"
          },
          "q2": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 == 0"
          },
          "q3": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 == 0"
          },
          "q4": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 == 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId",
        "games": {
          "$gameId": {
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            }
          }
        },
        "joinedGames": {
          "$gameId": {
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            }
          }
        },
        "activeBoardId": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9]+$/)"
        },
        "autoManageOff": {
          ".validate": "newData.isBoolean()"
        },
        "tvToken": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{20,64}$/)"
        },
        "firstTouch": {
          ".validate": "newData.hasChildren(['at', 'path'])",
          "at": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "path": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "ref": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "src": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "med": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "camp": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        },
        "usage": {
          "gamesCreated": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "resets": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "deletes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "lastGameAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        }
      }
    },
    "tvTokenOwners": {
      "$token": {
        ".read": false,
        ".write": "auth != null && $token.matches(/^[A-Za-z0-9_-]{20,64}$/) && ((!data.exists() && newData.val() == auth.uid && auth.token.firebase.sign_in_provider != 'anonymous') || (data.val() == auth.uid && !newData.exists() && !root.child('tvLinks').child($token).exists()))",
        ".validate": "newData.isString() && newData.val() == auth.uid"
      }
    },
    "tvLinks": {
      "$token": {
        ".read": true,
        ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && $token.matches(/^[A-Za-z0-9_-]{20,64}$/) && root.child('tvTokenOwners').child($token).val() == auth.uid",
        ".validate": "newData.hasChildren(['boards', 'interval'])",
        "boards": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{6}(,[A-Za-z0-9]{6}){0,19}$/)" },
        "interval": { ".validate": "newData.isNumber() && (newData.val() == 10 || newData.val() == 20 || newData.val() == 30 || newData.val() == 60)" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "$other": { ".validate": false }
      }
    },
    "openBoards": {
      "$ownerId": {
        ".read": true,
        "$boardId": {
          ".write": "auth != null && auth.uid == $ownerId && root.child('games').child($boardId).child('ownerId').val() == $ownerId",
          ".validate": "newData.val() == true"
        }
      }
    },
    "boardStats": {
      "$boardId": {
        ".read": "auth != null && (root.child('games').child($boardId).child('ownerId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "root.child('games').child($boardId).exists()",
        "fullBoardViews": { ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1 && newData.val() <= 100000" },
        "startYourOwnClicks": { ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1 && newData.val() <= 100000" },
        "otherBoardJoins": { ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1 && newData.val() <= 100000" },
        "fullBoardViewsWithOpenBoards": { ".validate": "newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1 && newData.val() <= 100000" },
        "$other": { ".validate": false }
      }
    },
    "upgradeViews": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['firstAt', 'lastAt', 'count'])",
        "firstAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "lastAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "count": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000" },
        "limitCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "$other": { ".validate": false }
      }
    },
    "notifyMe": {
      ".read": false,
      "$pushId": {
        ".read": false,
        ".write": "auth != null && !data.exists() && $pushId.length <= 128 && $pushId.matches(/^[A-Za-z0-9_-]+$/)",
        ".validate": "newData.hasChildren(['email', 'timestamp', 'uid', 'source'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 254 && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/)"
        },
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000 && newData.val() >= now - 86400000"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() == auth.uid && newData.val().length <= 128"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "prefilled": {
          ".validate": "newData.isBoolean()"
        },
        "trigger": {
          ".validate": "newData.isString() && (newData.val() == 'limit' || newData.val() == 'pass')"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "autoManageQueue": {
      ".read": false,
      ".indexOn": [".value"],
      "$boardId": {
        ".write": "auth != null && $boardId.matches(/^[A-Za-z0-9]{6}$/) && (root.child('games').child($boardId).child('ownerId').val() == auth.uid || root.child('games').child($boardId).child('managerId').val() == auth.uid)",
        ".validate": "newData.isNumber() && newData.val() > 0"
      }
    },
    "liveGames": {
      ".read": false,
      "$espnId": {
        "$boardId": {
          ".write": "auth != null && $espnId.matches(/^[A-Za-z0-9_-]{1,50}$/) && $boardId.matches(/^[A-Za-z0-9]{6}$/) && (root.child('games').child($boardId).child('ownerId').val() == auth.uid || root.child('games').child($boardId).child('managerId').val() == auth.uid)",
          ".validate": "newData.hasChildren(['sport'])",
          "sport": {
            ".validate": "newData.isString() && (newData.val() == 'nfl' || newData.val() == 'nba' || newData.val() == 'ncaaf' || newData.val() == 'ufl' || newData.val() == 'wnba' || newData.val() == 'afl')"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "emailIndex": {
      "$email": {
        ".read": "auth != null",
        ".write": "auth != null && newData.val() == auth.uid"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "entitlements": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() == true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
        ".validate": "newData.hasChildren(['plan', 'expiresAt'])",
        "plan": {
          ".validate": "newData.isString() && (newData.val() == 'week' || newData.val() == 'season')"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "giftedSeasonPass": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() == true",
      "$encodedEmail": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() == true",
        ".validate": "newData.hasChildren(['expiresAt'])",
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
